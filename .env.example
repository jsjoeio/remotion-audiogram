# Same vars as jsjoe.io/workers/telegram-webhook (.dev.vars)
# Copy values from there; never commit .env
TELEGRAM_BOT_TOKEN=
ALLOWED_TELEGRAM_USER_ID=
# Forum/community group chat_id (negative, e.g. -1001234567890).
# Needed to post the video in a client's topic. Get it from:
#   bun run get-telegram-topics -- "https://t.me/c/1234567890/25/33"
# (script lives in jsjoe.io/db)
TELEGRAM_GROUP_CHAT_ID=

# Cloudflare R2 (bucket: telegram-voice). Locally optional if you use `wrangler login`.
# Required for GitHub Actions — set the same names as repo Actions secrets.
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ACCOUNT_ID=

# Same vars as jsjoe.io/workers/telegram-webhook (.dev.vars)
# Copy values from there; never commit .env
TELEGRAM_BOT_TOKEN=
ALLOWED_TELEGRAM_USER_ID=
# Forum/community group chat_id (negative, e.g. -1001234567890).
# Needed to post the video in a client's topic. Get it from:
#   bun run get-telegram-topics -- "https://t.me/c/1234567890/25/33"
# (script lives in jsjoe.io/db)
TELEGRAM_GROUP_CHAT_ID=

# Cloudflare R2 — locally optional if you use `wrangler login`.
# Required for GitHub Actions — set the same names as repo Actions secrets.
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ACCOUNT_ID=

# Public program audio (app.jsjoe.io) — bucket created 2026-09-05
PUBLIC_AUDIO_BUCKET=wellness-program-audio
# After enabling Public Development URL or a custom domain on that bucket:
#   PUBLIC_AUDIO_BASE_URL=https://pub-<id>.r2.dev
#   # or production: https://audio.jsjoe.io
PUBLIC_AUDIO_BASE_URL=
# Optional AAC bitrate (default 96k)
# PUBLIC_AUDIO_BITRATE=96k
